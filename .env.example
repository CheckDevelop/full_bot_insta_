# Telegram
BOT_TOKEN=123456789:REPLACE_WITH_BOT_TOKEN

# Redis / Valkey
# Koyeb: put your Upstash Redis connection URL here.
# Render: you can use the connection string generated by a Render Key Value instance.
UPSTASH_REDIS_REST_URL=https://REPLACE_ME.upstash.io
UPSTASH_REDIS_REST_TOKEN=REPLACE_ME

# Public HTTPS URL of this service, WITHOUT /telegram at the end.
# Example: https://my-bot.example.com
WEBHOOK_URL=https://REPLACE_ME

# Long random secret used to authenticate Telegram webhook requests.
WEBHOOK_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS

# Instagram admin account and existing session JSON (or native Instaloader session) encoded as base64.
INSTAGRAM_USERNAME=your_admin_instagram_username
INSTAGRAM_SESSION_B64=REPLACE_WITH_BASE64_OF_SESSION_FILE

# Limits
RATE_LIMIT_COUNT=5
RATE_LIMIT_WINDOW_SECONDS=3600
COOLDOWN_SECONDS=10
DUPLICATE_TTL_SECONDS=3600
MAX_QUEUE_SIZE=20
MAX_RETRIES=2
RETRY_BACKOFF_SECONDS=5
REQUEST_TIMEOUT_SECONDS=60
MAX_MEDIA_BYTES=524288000

# Server
PORT=10000
TEMP_DIR=/tmp/instagram-bot
LOG_LEVEL=INFO
